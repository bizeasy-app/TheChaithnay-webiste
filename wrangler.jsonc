{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thechaithanya",
  "main": "workers/api/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "thechaithanya.com", "custom_domain": true },
    { "pattern": "www.thechaithanya.com", "custom_domain": true }
  ],
  "vars": {
    "NOTION_SUBSCRIBERS_DATA_SOURCE_ID": "41d579a1-9613-81bd-9ff1-000b3b8aff33",
    "NOTION_INBOX_DATA_SOURCE_ID": "41d579a1-9613-81a8-b2ae-000b2e13b7a1"
  }
}
