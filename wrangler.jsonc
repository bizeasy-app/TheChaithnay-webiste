{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thechaithanya",
  "main": "workers/api/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
  // Custom domains (thechaithanya.com / www) attach in the Cloudflare dashboard
  // after the zone is added. Until then, ship on *.workers.dev so CI can deploy.
}
