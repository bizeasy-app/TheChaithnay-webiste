# Build-time (GitHub Actions). Never commit real values.
NOTION_TOKEN=
NOTION_BLOG_DATABASE_ID=
NOTION_BLOG_DATA_SOURCE_ID=
NEXT_PUBLIC_SITE_URL=https://thechaithanya.com
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Local only: point the static site at the Worker while `wrangler dev` runs.
# Leave EMPTY for production builds (same-origin /api/*). Never commit a real value into
# a build that gets deployed — it will bake into the JS and break live forms.
NEXT_PUBLIC_API_BASE=

# Worker secrets (also copy into .dev.vars for `wrangler dev`).
# Set with `wrangler secret put` in production — never commit real values.
NOTION_SUBSCRIBERS_DATA_SOURCE_ID=
NOTION_INBOX_DATA_SOURCE_ID=

# GitHub Actions deploy
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
